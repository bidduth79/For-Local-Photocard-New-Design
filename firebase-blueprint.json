{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User data including download counts and premium status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "isAnonymous": { "type": "boolean" },
        "downloadCount": { "type": "number" },
        "isPremium": { "type": "boolean" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["uid", "isAnonymous", "downloadCount", "isPremium", "isAdmin"]
    },
    "ActivationCode": {
      "title": "ActivationCode",
      "description": "Codes generated by admins to grant premium access",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "createdAt": { "type": "number" },
        "createdBy": { "type": "string" },
        "isUsed": { "type": "boolean" },
        "usedBy": { "type": "string" },
        "usedAt": { "type": "number" }
      },
      "required": ["code", "createdAt", "createdBy", "isUsed"]
    },
    "SavedFont": {
      "title": "SavedFont",
      "description": "Custom fonts uploaded by users",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "originalName": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "url", "originalName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profiles and download limits"
    },
    "/activationCodes/{codeStr}": {
      "schema": { "$ref": "#/entities/ActivationCode" },
      "description": "Stores activation codes for premium access"
    },
    "/fonts/{fontId}": {
      "schema": { "$ref": "#/entities/SavedFont" },
      "description": "Stores metadata for custom fonts"
    }
  }
}
